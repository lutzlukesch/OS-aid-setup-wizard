{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Open-Source AID Setup Guide decision tree",
  "type": "object",
  "required": ["lastUpdated", "roles"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "lastUpdated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "roles": {
      "type": "object",
      "required": ["follower", "master"],
      "additionalProperties": false,
      "properties": {
        "follower": {
          "type": "object",
          "allOf": [{ "$ref": "#/definitions/roleBase" }],
          "properties": {
            "platforms": {
              "type": "object",
              "allOf": [{ "$ref": "#/definitions/platformsOf" }],
              "additionalProperties": { "$ref": "#/definitions/followerPlatform" }
            }
          }
        },
        "master": {
          "type": "object",
          "allOf": [{ "$ref": "#/definitions/roleBase" }],
          "properties": {
            "platforms": {
              "type": "object",
              "allOf": [{ "$ref": "#/definitions/platformsOf" }],
              "additionalProperties": { "$ref": "#/definitions/masterPlatform" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "text": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "pattern": "^https://" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },

    "roleBase": {
      "type": "object",
      "required": ["label", "steps", "platforms"],
      "properties": {
        "label": { "$ref": "#/definitions/text" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/text" } },
        "platforms": { "type": "object" }
      },
      "additionalProperties": false
    },

    "platformsOf": {
      "type": "object",
      "required": ["ios", "android"],
      "propertyNames": { "enum": ["ios", "android"] }
    },

    "followerPlatform": {
      "type": "object",
      "required": ["name", "subtitle", "costBadge", "costNote", "buildMethod", "masterAlgorithms"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/definitions/text" },
        "subtitle": { "$ref": "#/definitions/text" },
        "costBadge": { "$ref": "#/definitions/text" },
        "costNote": { "$ref": "#/definitions/text" },
        "buildMethod": { "$ref": "#/definitions/text" },
        "masterAlgorithms": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/followerAlgorithm" }
        }
      }
    },

    "masterPlatform": {
      "type": "object",
      "required": ["name", "subtitle", "costBadge", "costNote", "buildMethod", "algorithms"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/definitions/text" },
        "subtitle": { "$ref": "#/definitions/text" },
        "costBadge": { "$ref": "#/definitions/text" },
        "costNote": { "$ref": "#/definitions/text" },
        "buildMethod": { "$ref": "#/definitions/text" },
        "algorithms": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/masterAlgorithm" }
        }
      }
    },

    "followerAlgorithm": {
      "type": "object",
      "required": ["name", "badge", "summary", "buildOptions"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/definitions/text" },
        "badge": { "$ref": "#/definitions/text" },
        "summary": { "$ref": "#/definitions/text" },
        "buildOptions": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/buildOption" } }
      }
    },

    "buildOption": {
      "type": "object",
      "required": ["id", "name", "purpose", "installMethod", "requiresNightscout", "docsUrl"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "$ref": "#/definitions/text" },
        "purpose": { "$ref": "#/definitions/text" },
        "installMethod": { "$ref": "#/definitions/text" },
        "requiresNightscout": { "type": "boolean" },
        "docsUrl": { "$ref": "#/definitions/url" },
        "docsLabel": { "$ref": "#/definitions/text" }
      }
    },

    "masterAlgorithm": {
      "type": "object",
      "required": ["name", "engine", "badge", "summary", "startDocsUrl", "cgms", "pumps"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/definitions/text" },
        "engine": { "$ref": "#/definitions/text" },
        "badge": { "$ref": "#/definitions/text" },
        "summary": { "$ref": "#/definitions/text" },
        "startDocsUrl": { "$ref": "#/definitions/url" },
        "cgms": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/cgm" } },
        "pumps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/pump" } }
      }
    },

    "cgm": {
      "type": "object",
      "required": ["id", "name", "driverTag", "wakesAppInBackground", "howToUseWithAlgorithm", "cgmDocsUrl"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "$ref": "#/definitions/text" },
        "driverTag": { "$ref": "#/definitions/text" },
        "wakesAppInBackground": { "type": "boolean" },
        "extraNote": { "$ref": "#/definitions/text" },
        "howToUseWithAlgorithm": { "$ref": "#/definitions/text" },
        "cgmDocsUrl": { "$ref": "#/definitions/url" }
      }
    },

    "pump": {
      "type": "object",
      "required": ["id", "name", "type", "status", "support", "lifecycle", "requiresHeartbeatCgm", "driverInfo", "continueDocsUrl"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "$ref": "#/definitions/text" },
        "type": { "$ref": "#/definitions/text" },
        "status": { "$ref": "#/definitions/text", "description": "Display label only; logic uses support and lifecycle." },
        "support": { "enum": ["supported", "unsupported"] },
        "lifecycle": { "enum": ["active", "deprecated"] },
        "deprecatedNote": { "$ref": "#/definitions/text" },
        "requiresHeartbeatCgm": { "type": "boolean" },
        "driverInfo": { "$ref": "#/definitions/text" },
        "continueDocsUrl": { "oneOf": [{ "$ref": "#/definitions/url" }, { "type": "null" }] }
      },
      "if": { "properties": { "support": { "const": "unsupported" } } },
      "then": { "properties": { "continueDocsUrl": { "type": "null" } } }
    }
  }
}
